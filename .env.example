# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored. Never commit it or share your keys.
# run_local.py loads this file for the web app; odds_api.py loads it for ODDS_API_KEYS everywhere.

# --- Required for "Fetch odds" -------------------------------------------
# Your own key(s) from https://the-odds-api.com (free Starter plan; the key arrives by email).
# Comma-separated, no spaces needed. Keys are tried in order: when one runs out
# of quota the next one is used.
ODDS_API_KEYS=your_key_1,your_key_2

# --- Optional: web app ----------------------------------------------------
# Interface the web app binds to. 127.0.0.1 = this computer only (default).
# 0.0.0.0 = share on your local network.
# HOST=127.0.0.1

# Set to 1 to let other computers on the network use the refresh buttons
# (Refresh stats / Fetch odds). Default: only this computer can (Fetch odds spends credits).
# ALLOW_REMOTE_REFRESH=0

# --- Optional: season / week / model ---------------------------------------
# Pin the season and current week instead of asking Sleeper. Set BOTH or neither.
# NFL_SEASON=2026
# NFL_WEEK=10

# Picks model: v2 (default, calibrated and market-anchored) or v1 (3-game average + fixed thresholds).
# NFL_MODEL_VERSION=v2

# --- Advanced / testing: file locations ------------------------------------
# SQLite database (default: nfl_stats.db in the project folder).
# NFL_STATS_DB=nfl_stats.db
# Fitted model v2 parameters (default: model_v2_params.json in the project folder).
# NFL_MODEL_V2_PARAMS=model_v2_params.json
# Team stats used for matchup notes (default: team_stats_data.json in the project folder).
# NFL_TEAM_STATS_PATH=team_stats_data.json
# Last-run info for the refresh buttons (default: refresh_state.json in the project folder).
# NFL_REFRESH_STATE=refresh_state.json
